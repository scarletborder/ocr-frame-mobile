# 换行策略：CI 在 macOS/Linux 上执行脚本，CRLF 会让 bash 报 `$'\r': command not found`。
# 因此存储与检出一律 LF，脚本额外显式钉死。
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.swift text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.h     text eol=lf
*.mm    text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.plist text eol=lf
*.xml   text eol=lf
*.gradle text eol=lf

# 模型 / 二进制一律不当文本处理
*.gguf  binary
*.onnx  binary
*.xcframework binary
*.aar   binary
